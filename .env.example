# Copy this file to `.env` and fill in your Claude API key.
# The backend reads ANTHROPIC_API_KEY to generate game events, score decisions
# and power the help chat. Without it, the game falls back to built-in sample
# events so the app still runs.
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI key for image generation: event illustrations, avatars, UI icons.
# Leave empty to disable images (the game falls back to emojis).
# gpt-image-1-mini = fastest model (kids wait less in-game), slightly less
# polished images than the bigger gpt-image models.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
